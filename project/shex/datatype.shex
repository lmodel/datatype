# metamodel_version: 1.12.0
# version: 2019-10-03
BASE <https://w3id.org/lmodel/datatype/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX data: <http://linked.data.gov.au/def/datatype/>
PREFIX linkml: <https://w3id.org/linkml/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<Boolean> CLOSED {
    (  $<Boolean_tes> data:value @linkml:Boolean ;
       rdf:type [ data:Boolean ] ?
    )
}

<Concept> CLOSED {
    (  $<Concept_tes> (  rdf:value @linkml:Uriorcurie ;
          data:vocabulary @linkml:Uriorcurie
       ) ;
       rdf:type [ data:Concept ] ?
    )
}

<Count> CLOSED {
    (  $<Count_tes> (  data:value @linkml:Integer ;
          data:uncertainty @linkml:Decimal ?
       ) ;
       rdf:type [ data:Count ] ?
    )
}

<Percent> CLOSED {
    (  $<Percent_tes> (  &<QuantitativeMeasure_tes> ;
          rdf:type [ data:QuantitativeMeasure ] ? ;
          data:unit @linkml:Uriorcurie ;
          data:value @linkml:Decimal
       ) ;
       rdf:type [ data:Percent ] ?
    )
}

<PercentRange> CLOSED {
    (  $<PercentRange_tes> (  &<QuantitativeRange_tes> ;
          rdf:type [ data:QuantitativeRange ] ? ;
          data:unit @linkml:Uriorcurie ;
          data:min @linkml:Decimal ;
          data:max @linkml:Decimal
       ) ;
       rdf:type [ data:PercentRange ] ?
    )
}

<QuantitativeMeasure>  (
    CLOSED {
       (  $<QuantitativeMeasure_tes> (  data:value @linkml:Decimal ;
             data:unit @linkml:Uriorcurie ;
             data:uncertainty @linkml:Decimal ?
          ) ;
          rdf:type [ data:QuantitativeMeasure ] ?
       )
    } OR @<Percent>
)

<QuantitativeRange>  (
    CLOSED {
       (  $<QuantitativeRange_tes> (  data:min @linkml:Decimal ;
             data:max @linkml:Decimal ;
             data:unit @linkml:Uriorcurie ;
             data:uncertainty @linkml:Decimal ?
          ) ;
          rdf:type [ data:QuantitativeRange ] ?
       )
    } OR @<PercentRange>
)

<Text> CLOSED {
    (  $<Text_tes> data:value @linkml:String ;
       rdf:type [ data:Text ] ?
    )
}
