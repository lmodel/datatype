	linkml:tag "upstream_creator"^^xsd:anyURI .
_:c14n17 sh:namespace "http://linked.data.gov.au/def/datatype/"^^xsd:anyURI ;
	sh:prefix "data" .
_:c14n2 skos:example "CC0-1.0 in the ontology's dcterms:license; CC-BY-4.0 in the repository's LICENSE" ;
	linkml:tag "upstream_licence"^^xsd:anyURI .
_:c14n3 skos:example "https://github.com/AGLDWG/datatype-ont" ;
	linkml:tag "upstream_repository"^^xsd:anyURI .
_:c14n4 skos:example "2019-03-25" ;
	linkml:tag "upstream_created"^^xsd:anyURI .
_:c14n6 sh:namespace "https://w3id.org/linkml/"^^xsd:anyURI ;
	sh:prefix "linkml" .
_:c14n9 skos:example "master" ;
	linkml:tag "upstream_branch"^^xsd:anyURI .

