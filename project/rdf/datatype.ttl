	skos:mappingRelation "http://linked.data.gov.au/def/datatype/unit"^^xsd:anyURI ;
	skos:note "The ontology's owl:hasValue: the unit is QUDT's PERCENT and no other. A pattern states it, since equals_string needs a string range." ;
	skos:prefLabel "unit" ;
	linkml:definition_uri "https://w3id.org/lmodel/datatype/unit"^^xsd:anyURI ;
	linkml:description "Measurement scale" ;
	linkml:domain <https://w3id.org/lmodel/datatype/PercentRange> ;
	linkml:domain_of <https://w3id.org/lmodel/datatype/PercentRange> ;
	linkml:is_a <https://w3id.org/lmodel/datatype/QuantitativeRange_unit> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/datatype/PercentRange> ;
	linkml:pattern "^http://qudt\\.org/vocab/unit/PERCENT$" ;
	linkml:range <https://w3id.org/lmodel/datatype/uriorcurie> ;
	linkml:required true ;
	linkml:slot_uri "http://linked.data.gov.au/def/datatype/unit"^^xsd:anyURI ;
	linkml:usage_slot_name "unit" .
