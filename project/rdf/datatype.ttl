<https://w3id.org/lmodel/datatype/datatype> dcterms:license "Apache-2.0" ;
	dcterms:source "http://linked.data.gov.au/def/datatype"^^xsd:anyURI ;
	dcterms:title "Datatype Ontology" ;
	pav:version "2019-10-03" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://github.com/AGLDWG/datatype-ont/tree/dd8f24120cd59f686086f58175de37807c569e18"^^xsd:anyURI , "https://lmodel.github.io/datatype"^^xsd:anyURI ;
	skos:note "The classes are closed: a value carries only the properties the ontology's restrictions on its class name. OWL leaves a class open to other properties, so data that adds, say, a standard to a QuantitativeMeasure is valid OWL but not valid here." , "The ontology states no owl:versionInfo or owl:versionIRI, and its repository has no tag or release, so the version is the ontology's dcterms:modified date. upstream/ copies its Turtle file and licence at the commit in the annotations, and scripts/check_upstream_release.py reports when the master branch moves." , "The title and description of each of the ontology's terms are its rdfs:label and skos:definition. The ontology states CC0 1.0 as its dcterms:license, and the repository's LICENSE, added later, is CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/). This rendering follows CC BY 4.0, is provided as is, and carries the attribution that https://github.com/lmodel/datatype/blob/main/NOTICE gives." ;
	sh:declare _:c14n11 , _:c14n13 , _:c14n14 , _:c14n17 , _:c14n6 ;
	linkml:annotations _:c14n10 , _:c14n16 , _:c14n2 , _:c14n3 , _:c14n4 , _:c14n9 ;
