<https://w3id.org/lmodel/datatype/Boolean> dcterms:title "Boolean" ;
	a linkml:ClassDefinition ;
	skos:exactMatch "data:Boolean"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/datatype"^^xsd:anyURI ;
	linkml:class_uri "http://linked.data.gov.au/def/datatype/Boolean"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/datatype/Boolean"^^xsd:anyURI ;
	linkml:description "Class to encapsulate a true-or-false value" ;
	linkml:slot_usage _:c14n12 ;
	linkml:slots <https://w3id.org/lmodel/datatype/Boolean_value> .
<https://w3id.org/lmodel/datatype/Boolean_value> dcterms:title "data value" ;
