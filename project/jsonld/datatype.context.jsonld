{
   "@context": {
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "data": "http://linked.data.gov.au/def/datatype/",
      "datatype_linkml": "https://w3id.org/lmodel/datatype/",
      "linkml": "https://w3id.org/linkml/",
      "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "@vocab": "https://w3id.org/lmodel/datatype/",
      "max": {
         "@type": "xsd:decimal",
         "@id": "data:max"
      },
      "min": {
         "@type": "xsd:decimal",
         "@id": "data:min"
      },
      "rdf_value": {
         "@id": "rdf:value"
      },
      "standard": {
         "@type": "xsd:anyURI",
         "@id": "data:standard"
      },
      "uncertainty": {
         "@type": "xsd:decimal",
         "@id": "data:uncertainty"
      },
      "unit": {
         "@type": "xsd:anyURI",
         "@id": "data:unit"
      },
      "value": {
         "@id": "data:value"
      },
      "vocabulary": {
         "@type": "xsd:anyURI",
         "@id": "data:vocabulary"
      },
      "Boolean": {
         "@id": "data:Boolean",
         "@context": {
            "value": {
               "@id": "data:value",
               "@type": "xsd:boolean"
            }
         }
      },
      "Concept": {
         "@id": "data:Concept",
         "@context": {
            "rdf_value": {
               "@id": "rdf:value",
               "@type": "xsd:anyURI"
            }
         }
      },
      "Count": {
         "@id": "data:Count",
         "@context": {
            "value": {
               "@id": "data:value",
               "@type": "xsd:integer"
            }
         }
      },
      "Percent": {
         "@id": "data:Percent"
      },
      "PercentRange": {
         "@id": "data:PercentRange"
      },
      "QuantitativeMeasure": {
         "@id": "data:QuantitativeMeasure",
         "@context": {
            "value": {
               "@id": "data:value",
               "@type": "xsd:decimal"
            }
         }
      },
      "QuantitativeRange": {
         "@id": "data:QuantitativeRange"
      },
      "Text": {
         "@id": "data:Text"
      }
   }
}
