@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix data: <http://linked.data.gov.au/def/datatype/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix datatype_linkml: <https://w3id.org/lmodel/datatype/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pav: <http://purl.org/pav/> .
<https://w3id.org/lmodel/datatype.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <http://linked.data.gov.au/def/datatype> ;
	dcterms:title "Datatype Ontology" ;
	pav:version "2019-10-03" ;
	a owl:Ontology ;
	rdfs:label "datatype" ;
	rdfs:seeAlso <https://github.com/AGLDWG/datatype-ont/tree/dd8f24120cd59f686086f58175de37807c569e18> , <https://lmodel.github.io/datatype> ;
	skos:definition "A LinkML rendering of the Datatype Ontology (\"Datatypes\") of the Australian Government Linked Data Working Group (AGLDWG), by Simon Cox of CSIRO. In its own words: a set of classes representing data-types. These may be used for observation results, or for the range of specific properties in other applications where scaled numbers, ranges, percents etc are required. Each class and property keeps the ontology's local name and IRI." ;
	skos:note "The classes are closed: a value carries only the properties the ontology's restrictions on its class name. OWL leaves a class open to other properties, so data that adds, say, a standard to a QuantitativeMeasure is valid OWL but not valid here." , "The ontology states no owl:versionInfo or owl:versionIRI, and its repository has no tag or release, so the version is the ontology's dcterms:modified date. upstream/ copies its Turtle file and licence at the commit in the annotations, and scripts/check_upstream_release.py reports when the master branch moves." , "The ontology's own dcterms:license is CC0 1.0, and the repository's LICENSE, added later, is CC BY 4.0. Each description is the ontology's skos:definition of the term, used with the attribution NOTICE gives." , "Three rules are this project's, not the ontology's, each marked where it is stated: a percent lies between 0 and 100, an uncertainty is not negative, and a range's min is not above its max. The validator checks the first two; no validator can compare two slots, so tests/test_data.py checks the third over the examples." ;
	datatype_linkml:upstream_branch "master" ;
	datatype_linkml:upstream_commit "dd8f24120cd59f686086f58175de37807c569e18" ;
	datatype_linkml:upstream_created "2019-03-25" ;
	datatype_linkml:upstream_creator "Simon J.D. Cox, CSIRO, https://orcid.org/0000-0002-3884-3420" ;
	datatype_linkml:upstream_licence "CC0-1.0 in the ontology's dcterms:license; CC-BY-4.0 in the repository's LICENSE" ;
	datatype_linkml:upstream_repository "https://github.com/AGLDWG/datatype-ont" .
datatype_linkml:Boolean dcterms:title "Boolean" ;
	a owl:Class ;
	rdfs:label "Boolean" ;
	rdfs:subClassOf _:c14n29 , _:c14n48 , _:c14n5 ;
	skos:definition "Class to encapsulate a true-or-false value" ;
	skos:exactMatch data:Boolean ;
	skos:inScheme <https://w3id.org/lmodel/datatype> .
datatype_linkml:Concept dcterms:title "Concept" ;
	a owl:Class ;
	rdfs:label "Concept" ;
	rdfs:subClassOf _:c14n12 , _:c14n15 , _:c14n17 , _:c14n25 , _:c14n28 , _:c14n42 ;
	skos:definition "Class to encapsulate a classifier, usually a values from a controlled vocabulary" ;
	skos:exactMatch data:Concept ;
	skos:inScheme <https://w3id.org/lmodel/datatype> .
datatype_linkml:Count dcterms:title "Count" ;
	a owl:Class ;
	rdfs:label "Count" ;
	rdfs:subClassOf _:c14n1 , _:c14n31 , _:c14n32 , _:c14n38 , _:c14n49 , _:c14n54 ;
	skos:definition "Class to encapsulate an integer value" ;
	skos:exactMatch data:Count ;
	skos:inScheme <https://w3id.org/lmodel/datatype> .
datatype_linkml:Percent dcterms:title "Percent" ;
	a owl:Class ;
	rdfs:label "Percent" ;
	rdfs:subClassOf datatype_linkml:QuantitativeMeasure , _:c14n16 , _:c14n22 , _:c14n24 , _:c14n3 , _:c14n41 , _:c14n53 ;
	skos:definition "Class to encapsulate a quantitative measure expressed as a percent value" ;
	skos:exactMatch data:Percent ;
	skos:inScheme <https://w3id.org/lmodel/datatype> .
datatype_linkml:PercentRange dcterms:title "Percent range" ;
	a owl:Class ;
	rdfs:label "PercentRange" ;
	rdfs:subClassOf datatype_linkml:QuantitativeRange , _:c14n18 , _:c14n21 , _:c14n26 , _:c14n30 , _:c14n35 , _:c14n37 , _:c14n39 , _:c14n47 , _:c14n9 ;
	skos:definition "Class to encapsulate a quantitative range expressed as in percent values" ;
	skos:exactMatch data:PercentRange ;
	skos:inScheme <https://w3id.org/lmodel/datatype> .
datatype_linkml:QuantitativeMeasure dcterms:title "Quantitative Measure" ;
	a owl:Class ;
	rdfs:label "QuantitativeMeasure" ;
	rdfs:subClassOf _:c14n0 , _:c14n11 , _:c14n2 , _:c14n23 , _:c14n27 , _:c14n34 , _:c14n40 , _:c14n50 , _:c14n8 ;
	skos:definition "Class to encapsulate a quantitative measure value" ;
	skos:exactMatch data:QuantitativeMeasure ;
	skos:inScheme <https://w3id.org/lmodel/datatype> .
datatype_linkml:QuantitativeRange dcterms:title "Quantitative Range" ;
	a owl:Class ;
	rdfs:label "QuantitativeRange" ;
	rdfs:subClassOf _:c14n10 , _:c14n14 , _:c14n19 , _:c14n20 , _:c14n36 , _:c14n4 , _:c14n45 , _:c14n46 , _:c14n51 , _:c14n52 , _:c14n6 , _:c14n7 ;
	skos:definition "Class to encapsulate a quantitative range" ;
	skos:exactMatch data:QuantitativeRange ;
	skos:inScheme <https://w3id.org/lmodel/datatype> ;
	skos:note "This project's rule: min is not above max. No validator can compare two slots, so tests/test_data.py checks it over the examples." .
datatype_linkml:Text dcterms:title "Text" ;
	a owl:Class ;
	rdfs:label "Text" ;
	rdfs:subClassOf _:c14n33 , _:c14n43 , _:c14n44 ;
	skos:definition "Class to encapsulate a textual value" ;
	skos:exactMatch data:Text ;
	skos:inScheme <https://w3id.org/lmodel/datatype> .
datatype_linkml:max dcterms:title "data maximum" ;
	a owl:DatatypeProperty ;
	rdfs:label "max" ;
	rdfs:range xsd:decimal ;
	rdfs:subPropertyOf datatype_linkml:rdf_value ;
	skos:definition "Maximum value of a range" ;
	skos:inScheme <https://w3id.org/lmodel/datatype> .
datatype_linkml:min dcterms:title "data minimum" ;
	a owl:DatatypeProperty ;
	rdfs:label "min" ;
	rdfs:range xsd:decimal ;
	rdfs:subPropertyOf datatype_linkml:rdf_value ;
	skos:definition "Minimum value of range" ;
	skos:inScheme <https://w3id.org/lmodel/datatype> .
datatype_linkml:rdf_value dcterms:title "value" ;
	a owl:DatatypeProperty ;
	rdfs:label "rdf_value" ;
	skos:definition "The main value of a structured value, as RDF's own rdf:value property names it. The ontology restricts it on Concept and makes value, min, max and uncertainty its sub-properties." ;
	skos:inScheme <https://w3id.org/lmodel/datatype> .
datatype_linkml:standard dcterms:title "data standard" ;
	a owl:DatatypeProperty ;
	rdfs:label "standard" ;
	rdfs:range xsd:anyURI ;
	skos:definition "Measurement standard, scale, uom, reference system, controlled vocabulary, taxonomy etc" ;
	skos:inScheme <https://w3id.org/lmodel/datatype> ;
	skos:note "No class of the ontology restricts this property; it is the parent of unit and vocabulary." .
datatype_linkml:uncertainty dcterms:title "data uncertainty" ;
	a owl:DatatypeProperty ;
	rdfs:label "uncertainty" ;
	rdfs:range _:c14n13 ;
	rdfs:subPropertyOf datatype_linkml:rdf_value ;
	skos:definition "Uncertainty for a quantitative value" ;
	skos:inScheme <https://w3id.org/lmodel/datatype> ;
	skos:note "This project's rule: an uncertainty is not negative. The ontology states no bound." .
datatype_linkml:unit dcterms:title "unit of measure" ;
	a owl:DatatypeProperty ;
	rdfs:label "unit" ;
	rdfs:range xsd:anyURI ;
	rdfs:subPropertyOf datatype_linkml:standard ;
	skos:definition "Measurement scale" ;
	skos:inScheme <https://w3id.org/lmodel/datatype> ;
	skos:note "The unit by its IRI, such as http://qudt.org/vocab/unit/M from the QUDT units vocabulary. The ontology states no range." .
datatype_linkml:value dcterms:title "data value" ;
	a owl:DatatypeProperty ;
	rdfs:label "value" ;
	rdfs:subPropertyOf datatype_linkml:rdf_value ;
	skos:definition "simple value (a literal)" ;
	skos:inScheme <https://w3id.org/lmodel/datatype> .
datatype_linkml:vocabulary dcterms:title "vocabulary" ;
	a owl:DatatypeProperty ;
	rdfs:label "vocabulary" ;
	rdfs:range xsd:anyURI ;
	rdfs:subPropertyOf datatype_linkml:standard ;
	skos:definition "controlled vocabulary, taxonomy etc" ;
	skos:inScheme <https://w3id.org/lmodel/datatype> ;
	skos:note "The vocabulary by its IRI. The ontology's range is a skos:ConceptScheme, a skos:Collection or an owl:Ontology, which the validator cannot check of an IRI." .
