data:PercentRange a sh:NodeShape ;
	rdfs:comment "Class to encapsulate a quantitative range expressed as in percent values" ;
	rdfs:label "Percent range" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n13 ;
