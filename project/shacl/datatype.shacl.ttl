data:Boolean a sh:NodeShape ;
	rdfs:comment "Class to encapsulate a true-or-false value" ;
	rdfs:label "Boolean" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n20 ;
	sh:property _:c14n9 ;
	sh:targetClass data:Boolean .
data:Concept a sh:NodeShape ;
	rdfs:comment "Class to encapsulate a classifier, usually a values from a controlled vocabulary" ;
	rdfs:label "Concept" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n19 ;
	sh:property _:c14n14 , _:c14n25 ;
	sh:targetClass data:Concept .
data:Count a sh:NodeShape ;
