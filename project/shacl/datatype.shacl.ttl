data:QuantitativeMeasure a sh:NodeShape ;
	rdfs:comment "Class to encapsulate a quantitative measure value" ;
	rdfs:label "Quantitative Measure" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n8 ;
	sh:property _:c14n2 , _:c14n24 , _:c14n27 ;
	sh:targetClass data:QuantitativeMeasure .
data:QuantitativeRange a sh:NodeShape ;
	rdfs:comment "Class to encapsulate a quantitative range" ;
	rdfs:label "Quantitative Range" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n22 ;
	sh:property _:c14n0 , _:c14n1 , _:c14n10 , _:c14n23 ;
	sh:targetClass data:QuantitativeRange .
data:Text a sh:NodeShape ;
	rdfs:comment "Class to encapsulate a textual value" ;
	rdfs:label "Text" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n17 ;
	sh:property _:c14n7 ;
