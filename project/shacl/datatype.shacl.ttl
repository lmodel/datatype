	rdfs:label "Count" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n12 ;
	sh:property _:c14n4 , _:c14n5 ;
	sh:targetClass data:Count .
data:Percent a sh:NodeShape ;
	rdfs:comment "Class to encapsulate a quantitative measure expressed as a percent value" ;
	rdfs:label "Percent" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n26 ;
	sh:property _:c14n15 , _:c14n16 , _:c14n18 ;
